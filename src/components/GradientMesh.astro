---
/**
 * GradientMesh — Animated gradient mesh hero background
 *
 * Full-viewport animated background using CSS + GSAP.
 * Blobs drift slowly using ambient duration tokens.
 * Respects prefers-reduced-motion (static gradient fallback).
 *
 * Usage:
 *   <GradientMesh />               — default yellow/purple brand colors
 *   <GradientMesh variant="dark" /> — dark-optimized version
 */

interface Props {
  variant?: 'default' | 'dark';
  class?: string;
}

const { variant = 'default', class: className } = Astro.props;
---

<div
  class:list={['gradient-mesh', `gradient-mesh--${variant}`, className]}
  aria-hidden="true"
>
  <div class="gradient-mesh__blob gradient-mesh__blob--1"></div>
  <div class="gradient-mesh__blob gradient-mesh__blob--2"></div>
  <div class="gradient-mesh__blob gradient-mesh__blob--3"></div>
</div>

<style>
  .gradient-mesh {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .gradient-mesh__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.65;
    will-change: transform;
  }

  /* Blob 1 — brand primary (yellow) */
  .gradient-mesh__blob--1 {
    width: 70vw;
    height: 70vw;
    max-width: 960px;
    max-height: 960px;
    background: radial-gradient(circle, #eab308 0%, #f59e0b 30%, transparent 70%);
    top: -25%;
    left: -20%;
  }

  /* Blob 2 — brand secondary (purple) */
  .gradient-mesh__blob--2 {
    width: 60vw;
    height: 60vw;
    max-width: 840px;
    max-height: 840px;
    background: radial-gradient(circle, #a855f7 0%, #8b5cf6 30%, transparent 70%);
    top: 5%;
    right: -25%;
  }

  /* Blob 3 — accent midpoint (blue-teal) */
  .gradient-mesh__blob--3 {
    width: 50vw;
    height: 50vw;
    max-width: 720px;
    max-height: 720px;
    background: radial-gradient(circle, #06b6d4 0%, #0ea5e9 30%, transparent 70%);
    bottom: -15%;
    left: 25%;
  }

  /* Dark variant — reduced opacity so blobs don't overpower dark bg */
  .gradient-mesh--dark .gradient-mesh__blob {
    opacity: 0.18;
    filter: blur(80px);
  }

  /* Reduced motion — completely static */
  @media (prefers-reduced-motion: reduce) {
    .gradient-mesh__blob {
      animation: none !important;
    }
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '@utils/gsap';
  import { duration, ease } from '@/lib/motion-tokens';

  if (!prefersReducedMotion) {
    const blobs = document.querySelectorAll('.gradient-mesh__blob');

    // Blob 1 — slow drift top-left
    gsap.to(blobs[0], {
      x: '8vw',
      y: '5vw',
      duration: duration.ambient * 1.2,
      ease: ease.inOutSine,
      repeat: -1,
      yoyo: true,
    });

    // Blob 2 — drift top-right, slightly offset timing
    gsap.to(blobs[1], {
      x: '-6vw',
      y: '8vw',
      duration: duration.ambient * 0.9,
      ease: ease.inOutSine,
      repeat: -1,
      yoyo: true,
      delay: 0.8,
    });

    // Blob 3 — drift bottom-center
    gsap.to(blobs[2], {
      x: '4vw',
      y: '-6vw',
      duration: duration.ambient * 1.1,
      ease: ease.inOutSine,
      repeat: -1,
      yoyo: true,
      delay: 1.5,
    });
  }
</script>
