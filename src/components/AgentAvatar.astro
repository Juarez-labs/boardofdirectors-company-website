---
/**
 * AgentAvatar — character portrait image
 *
 * Renders the approved Higgsfield character portrait for each agent.
 * Portrait images live in /public/avatars/higgsfield/<alias>/.
 *
 * The wrapper div carries the motion-system body class (e.g. `ceo-body`)
 * so the GSAP float / glow timelines can target it. SVG-specific selectors
 * (crown, HUD eyes, etc.) will silently no-op per `nullTargetWarn: false`.
 *
 * Usage:
 *   <AgentAvatar agent="ceo" />
 *   <AgentAvatar agent="cto" size={120} />
 */

export type AgentId = 'ceo' | 'cto' | 'cmo' | 'uxdesigner' | 'motiondesigner' | 'icengineer' | 'branddesigner' | 'designsystemseng' | 'docops' | 'securityengineer' | 'qcagent';

interface Props {
  agent: AgentId;
  size?: number;
  class?: string;
}

const { agent, size = 200, class: className } = Astro.props;

/** Public URL → portrait image for each agent */
const portraitSrc: Record<AgentId, string> = {
  ceo:              '/avatars/higgsfield/ceo/portrait.webp',
  cto:              '/avatars/higgsfield/cto/portrait.webp',
  cmo:              '/avatars/higgsfield/cmo/portrait.png',
  uxdesigner:       '/avatars/higgsfield/lumen/portrait.webp',
  motiondesigner:   '/avatars/higgsfield/aura/portrait.webp',
  icengineer:       '/avatars/higgsfield/ice-form/portrait.png',
  branddesigner:    '/avatars/higgsfield/gradient/portrait.webp',
  designsystemseng: '/avatars/higgsfield/dse-unit/portrait.webp',
  docops:           '/avatars/higgsfield/docops-adult/portrait.webp',
  securityengineer: '/avatars/higgsfield/axis-h/portrait.webp',
  qcagent:          '/avatars/higgsfield/spark/portrait.webp',
};

/**
 * Per-agent CSS object-position to frame the subject well inside the
 * circular crop. Wide-format (16:9) images need adjustment so the
 * character occupies the center of the circle rather than being cut off.
 */
const objectPosition: Record<AgentId, string> = {
  ceo:              'center top',
  cto:              'center top',
  cmo:              'center top',
  uxdesigner:       'center center',   // square image, panel entity centered
  motiondesigner:   'center center',   // circular containment perfectly centered
  icengineer:       'center top',      // portrait-format, face near top
  branddesigner:    'center center',   // square image, prism centered
  designsystemseng: 'center center',   // beetle robot roughly centered
  docops:           '72% center',      // 16:9 frame — main Naut is right-of-center
  securityengineer: 'center top',      // 16:9 frame — head/chest reactor framing
  qcagent:          'center top',      // 16:9 frame — robot head/reactor framing
};

/** Character display names for alt text */
const characterName: Record<AgentId, string> = {
  ceo:              'CEO',
  cto:              'CTO',
  cmo:              'CMO',
  uxdesigner:       'Lumen — UX Designer',
  motiondesigner:   'Aura — Motion Designer',
  icengineer:       'IC Engineer',
  branddesigner:    'Gradient — Brand Designer',
  designsystemseng: 'Aethel — Design Systems Engineer',
  docops:           'Nautilus — DocOps',
  securityengineer: 'Axis-H — Security Engineer',
  qcagent:          'Spark — QC Agent',
};

/** Motion-system body class — matches GSAP selectors in avatar-motion.ts */
const bodyClass: Record<AgentId, string> = {
  ceo:              'ceo-portrait ceo-body',
  cto:              'cto-portrait cto-body',
  cmo:              'cmo-portrait cmo-body',
  uxdesigner:       'ux-body',
  motiondesigner:   'aura-body',
  icengineer:       'ic-body',
  branddesigner:    'brand-body',
  designsystemseng: 'dse-body',
  docops:           'docops-body',
  securityengineer: 'axis-body',
  qcagent:          'spark-body',
};

// Prepend BASE_URL so paths work on both root domain (/) and GitHub Pages
// subpath (/boardofdirectors-company-website/). BASE_URL always ends with '/'.
const base     = import.meta.env.BASE_URL.replace(/\/$/, '');
const src      = base + portraitSrc[agent];
const alt      = characterName[agent];
const body     = bodyClass[agent];
const objPos   = objectPosition[agent];
---

<div
  class:list={['agent-avatar', `agent-avatar--${agent}`, body, className]}
  style={`--avatar-size: ${size}px;`}
>
  <img
    src={src}
    alt={alt}
    width={size}
    height={size}
    loading="lazy"
    decoding="async"
    style={`object-position: ${objPos};`}
  />
</div>

<style>
  .agent-avatar {
    display: inline-block;
    width: var(--avatar-size);
    height: var(--avatar-size);
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    /* Subtle glow layer for the motion system to drive */
    box-shadow: 0 0 0 2px transparent;
    transition: box-shadow 0.3s ease;
  }

  .agent-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    border-radius: 50%;
  }
</style>
