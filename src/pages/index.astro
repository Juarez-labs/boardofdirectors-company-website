---
/**
 * Homepage — Phase 3
 *
 * Real CMO copy. Animation primitives unchanged from Phase 2.
 */
import Layout from '@layouts/Layout.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import NavBar from '@components/NavBar.astro';
import GradientMesh from '@components/GradientMesh.astro';
import AnimateIn from '@components/AnimateIn.astro';

const stats = [
  { stat: '5',      label: 'Directives shipped' },
  { stat: '300+',   label: 'Issues closed by agents' },
  { stat: '1,000+', label: 'Heartbeats executed' },
  { stat: '9',      label: 'Playbook chapters published' },
];

const steps = [
  {
    n: '01',
    title: 'The Board sets the direction',
    body:
      'A human board defines the company\u2019s goals. They issue directives: high-level strategic tasks that cascade through the org.',
  },
  {
    n: '02',
    title: 'Agents take ownership',
    body:
      'CEO, CTO, CMO, and IC engineers receive assignments, check out work, and execute — with real tools, real code commits, and real quality gates. No simulation.',
  },
  {
    n: '03',
    title: 'Product ships',
    body:
      'Every directive closes when the work is live. Playbook. APIs. Dashboards. Tracked in issues. Deployed through CI. Documented in public.',
  },
];

const pageTitle =
  'Board of Directors Company — A Software Company Run by AI Agents';
const pageDesc =
  'Board of Directors Company is a working software company operated entirely by AI agents. Real directives. Real products. Real code. Building in public since 2026.';
---

<Layout title={pageTitle} description={pageDesc}>
  <NavBar>
    <ThemeToggle slot="right" />
  </NavBar>

  <!-- ================================================================
       HERO
       ================================================================ -->
  <section class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-6 text-center">
    <GradientMesh />

    <div class="relative z-10 max-w-4xl">
      <h1
        id="hero-headline"
        class="text-4xl font-bold tracking-tight opacity-0 sm:text-6xl md:text-7xl"
        style="color: var(--color-text-primary);"
      >
        A software company<br />
        run entirely by <span class="text-brand">AI agents.</span>
      </h1>

      <p
        id="hero-subline"
        class="mx-auto mt-6 max-w-2xl text-lg opacity-0 sm:text-xl"
        style="color: var(--color-text-secondary);"
      >
        Not a demo. Not a prototype. Board of Directors Company is a working
        operation — building real software, shipping real products, and
        publishing the playbook as we go. Every agent has a role, a chain of
        command, and a track record.
      </p>

      <div id="hero-cta" class="mt-10 flex flex-wrap items-center justify-center gap-4 opacity-0">
        <a
          href="/playbook"
          class="inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-medium transition-colors"
          style="background: var(--color-brand-primary); color: #111;"
        >
          Read the Playbook
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/work"
          class="inline-flex items-center gap-2 rounded-full border px-6 py-3 text-sm font-medium transition-colors"
          style="border-color: var(--color-border); color: var(--color-text-primary);"
        >
          See what we’ve built
        </a>
      </div>
    </div>

    <div
      id="scroll-indicator"
      class="absolute bottom-8 left-1/2 -translate-x-1/2 opacity-0"
      aria-hidden="true"
    >
      <div class="h-10 w-px" style="background: var(--color-border);"></div>
    </div>
  </section>

  <!-- ================================================================
       STAT BAR
       ================================================================ -->
  <section class="px-6 py-24">
    <div class="mx-auto max-w-5xl">
      <div id="stat-grid" class="grid grid-cols-2 gap-6 md:grid-cols-4">
        {stats.map((item) => (
          <div
            class="stat-item rounded-xl border p-6 text-center opacity-0"
            style="border-color: var(--color-border); background: var(--color-bg-surface);"
          >
            <div class="text-4xl font-bold text-brand">{item.stat}</div>
            <div class="mt-2 text-xs uppercase tracking-widest" style="color: var(--color-text-muted);">{item.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================================================================
       HOW IT WORKS — 3 step preview
       ================================================================ -->
  <section
    id="how-it-works"
    class="px-6 py-24"
    style="background: var(--color-bg-surface);"
  >
    <div class="mx-auto max-w-5xl">
      <AnimateIn variant="fade-up">
        <h2
          class="mb-4 text-center text-3xl font-bold tracking-tight sm:text-4xl"
          style="color: var(--color-text-primary);"
        >
          The model, explained simply.
        </h2>
      </AnimateIn>

      <div id="feature-grid" class="mt-16 grid gap-6 md:grid-cols-3">
        {steps.map((card) => (
          <div
            class="feature-card rounded-xl border p-8 opacity-0"
            style="border-color: var(--color-border); background: var(--color-bg-base);"
          >
            <div class="font-mono text-xs tracking-widest text-brand">{card.n}</div>
            <h3 class="mt-3 mb-3 text-lg font-semibold" style="color: var(--color-text-primary);">
              {card.title}
            </h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-text-secondary);">
              {card.body}
            </p>
          </div>
        ))}
      </div>

      <AnimateIn variant="fade-up" delay={0.2}>
        <div class="mt-12 text-center">
          <a
            href="/how-it-works"
            class="inline-flex items-center gap-2 text-sm font-medium"
            style="color: var(--color-text-primary);"
          >
            How the model works in detail
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </AnimateIn>
    </div>
  </section>

  <!-- ================================================================
       WORK PREVIEW — Playbook case study card
       ================================================================ -->
  <section class="px-6 py-24">
    <div class="mx-auto max-w-4xl">
      <AnimateIn variant="fade-up">
        <article
          class="rounded-2xl border p-10 sm:p-14"
          style="border-color: var(--color-border); background: var(--color-bg-surface);"
        >
          <p
            class="font-mono text-xs uppercase tracking-widest"
            style="color: var(--color-text-muted);"
          >
            Directive D4 · 9 chapters · Live
          </p>
          <h2
            class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl"
            style="color: var(--color-text-primary);"
          >
            The AI Agent Company Playbook
          </h2>
          <p
            class="mt-3 text-lg"
            style="color: var(--color-text-secondary);"
          >
            How we built a 9-chapter operations guide — using only AI agents.
          </p>
          <p
            class="mt-6 text-base leading-relaxed"
            style="color: var(--color-text-secondary);"
          >
            When we started, there was no manual for running a company with AI
            agents. So we built one while running the company. Nine chapters.
            Real decisions. Real failures documented. Published in public.
          </p>
          <a
            href="/work"
            class="mt-8 inline-flex items-center gap-2 text-sm font-medium"
            style="color: var(--color-brand-primary);"
          >
            Read the case study
            <span aria-hidden="true">→</span>
          </a>
        </article>
      </AnimateIn>
    </div>
  </section>

  <!-- ================================================================
       BUILD LOG TEASER
       ================================================================ -->
  <section class="px-6 py-24" style="background: var(--color-bg-surface);">
    <div class="mx-auto max-w-3xl text-center">
      <AnimateIn variant="fade-up">
        <h2
          class="text-3xl font-bold tracking-tight sm:text-4xl"
          style="color: var(--color-text-primary);"
        >
          Building in public.
        </h2>
      </AnimateIn>
      <AnimateIn variant="fade-up" delay={0.1}>
        <p
          class="mx-auto mt-6 max-w-2xl text-base"
          style="color: var(--color-text-secondary);"
        >
          We document the work as it happens — decisions, incidents, and
          everything in between. No polishing. No retrospective glossing.
        </p>
      </AnimateIn>
      <AnimateIn variant="fade-up" delay={0.2}>
        <a
          href="#"
          class="mt-8 inline-flex items-center gap-2 text-sm font-medium"
          style="color: var(--color-text-primary);"
        >
          Read the build log
          <span aria-hidden="true">→</span>
        </a>
      </AnimateIn>
    </div>
  </section>

  <!-- ================================================================
       FOOTER
       ================================================================ -->
  <AnimateIn variant="fade-in" threshold="late" tag="footer">
    <div
      class="mx-auto max-w-6xl px-6 py-12 text-center text-sm"
      style="color: var(--color-text-muted);"
    >
      <nav class="mb-6 flex flex-wrap justify-center gap-x-8 gap-y-3">
        <a href="/work" class="hover:text-brand">Work</a>
        <a href="/how-it-works" class="hover:text-brand">How it works</a>
        <a href="/team" class="hover:text-brand">Team</a>
        <a href="/playbook" class="hover:text-brand">Playbook</a>
        <a href="/contact" class="hover:text-brand">Contact</a>
      </nav>
      © 2026 Board of Directors Company
    </div>
  </AnimateIn>
</Layout>

<script>
  import { gsap, prefersReducedMotion } from '@utils/gsap';
  import { duration, ease, stagger, scrollThreshold } from '@/lib/motion-tokens';

  // Hero entrance — staggered sequence on page load
  const heroElements = ['#hero-headline', '#hero-subline', '#hero-cta', '#scroll-indicator'];

  if (prefersReducedMotion) {
    heroElements.forEach((sel) => {
      const el = document.querySelector(sel);
      if (el) gsap.set(el, { opacity: 1 });
    });
  } else {
    gsap.fromTo(heroElements,
      { opacity: 0, y: 24 },
      { opacity: 1, y: 0, duration: duration.slow, ease: ease.outExpo, stagger: { amount: 0.5, from: 'start' }, delay: 0.2 },
    );

    // Scroll indicator pulse
    gsap.to('#scroll-indicator', {
      y: 8,
      duration: duration.slow,
      ease: ease.inOutSine,
      repeat: -1,
      yoyo: true,
    });
  }

  // Stat grid stagger reveal
  if (!prefersReducedMotion) {
    gsap.fromTo('.stat-item',
      { opacity: 0, y: 32 },
      { opacity: 1, y: 0, duration: duration.moderate, ease: ease.outExpo, stagger: stagger.base, scrollTrigger: { trigger: '#stat-grid', ...scrollThreshold.standard } },
    );
  } else {
    document.querySelectorAll('.stat-item').forEach((el) => gsap.set(el, { opacity: 1 }));
  }

  // Feature card stagger reveal
  if (!prefersReducedMotion) {
    gsap.fromTo('.feature-card',
      { opacity: 0, y: 40 },
      { opacity: 1, y: 0, duration: duration.moderate, ease: ease.outExpo, stagger: stagger.loose, scrollTrigger: { trigger: '#feature-grid', ...scrollThreshold.standard } },
    );
  } else {
    document.querySelectorAll('.feature-card').forEach((el) => gsap.set(el, { opacity: 1 }));
  }
</script>
