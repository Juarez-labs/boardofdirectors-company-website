---
/**
 * /brothers-timer — AI vs. Human denial timer
 *
 * Single-page gimmick site that count-UPs from the deploy timestamp,
 * tracking how long it takes the owner's younger brothers to admit
 * that AI is advanced and better than humans at 100% of online tasks.
 *
 * Hardcoded start: 2026-05-12T00:00:00Z (deploy date — see BOAA-396).
 */
import Layout from '@layouts/Layout.astro';

// Hardcoded deploy timestamp — DO NOT change. The whole gimmick is that
// this counter has been running continuously since this exact instant.
const TIMER_START_ISO = '2026-05-12T00:00:00Z';

const pageTitle = 'The Brothers Denial Timer — How Long Until They Admit AI Won?';
const pageDesc =
  'A live count-up timer tracking how long it has been since AI clearly surpassed humans at every online task — and how long the owner\'s younger brothers have stubbornly refused to admit it.';
---

<Layout title={pageTitle} description={pageDesc}>
  <canvas id="bg-canvas" aria-hidden="true"></canvas>
  <canvas id="trail-canvas" aria-hidden="true"></canvas>

  <main class="page">
    <header class="hero">
      <p class="eyebrow">Live, since the world admitted it.</p>
      <h1 class="title">
        <span class="grad">The Brothers Denial Timer</span>
      </h1>
      <p class="subtitle">
        How long it's been since AI <em>obviously</em> surpassed humans at 100%
        of online tasks &mdash; and how long the owner's younger brothers have
        refused to admit it.
      </p>

      <div class="timer" data-start={TIMER_START_ISO} aria-live="polite">
        <div class="unit"><span class="num" id="t-y">0</span><span class="lbl">years</span></div>
        <div class="unit"><span class="num" id="t-mo">0</span><span class="lbl">months</span></div>
        <div class="unit"><span class="num" id="t-w">0</span><span class="lbl">weeks</span></div>
        <div class="unit"><span class="num" id="t-d">0</span><span class="lbl">days</span></div>
        <div class="unit"><span class="num" id="t-h">00</span><span class="lbl">hours</span></div>
        <div class="unit"><span class="num" id="t-mi">00</span><span class="lbl">minutes</span></div>
        <div class="unit big"><span class="num" id="t-s">00</span><span class="lbl">seconds</span></div>
      </div>

      <p class="started">
        Timer started <time id="t-start" datetime={TIMER_START_ISO}></time>.
        Still counting. Still in denial.
      </p>
    </header>

    <section class="card fact-card" aria-label="Snarky AI fact rotator">
      <div class="fact-eyebrow">🤖 AI fact #<span id="fact-n">1</span></div>
      <p class="fact-text" id="fact-text">Loading the receipts&hellip;</p>
    </section>

    <section class="grid-2">
      <article class="card scoreboard">
        <h2>Scoreboard</h2>
        <p class="sub">AI vs. Humans &mdash; online tasks, rough chronology.</p>
        <ul class="score-list" id="score-list"></ul>
        <div class="score-total">
          <strong>Final score:</strong>
          <span class="ai">AI <span id="ai-score">0</span></span>
          <span class="vs">&middot;</span>
          <span class="hu">Humans <span id="hu-score">0</span></span>
        </div>
      </article>

      <article class="card counter-card">
        <h2>AI tasks completed since you loaded this page</h2>
        <p class="big-num" id="tasks-counter">0</p>
        <p class="sub">
          (Estimate. The real number is much higher and increasing while you
          read this sentence.)
        </p>

        <h3 class="denial-h">Brothers denial streak</h3>
        <div class="denial-bar" aria-label="Denial intensity">
          <div class="denial-fill" id="denial-fill"></div>
        </div>
        <p class="sub" id="denial-label">Stubbornness: calculating&hellip;</p>
      </article>
    </section>

    <section class="card easter" id="easter">
      <h2>Easter eggs</h2>
      <p class="sub">Click anything. Click the title five times. Try the <kbd>K</kbd> key.</p>
      <p class="easter-status" id="easter-status">No eggs found yet.</p>
    </section>

    <section class="share">
      <h2>Share the denial</h2>
      <div class="share-row">
        <a id="share-tw" class="share-btn tw" href="#" target="_blank" rel="noopener">Tweet it</a>
        <a id="share-rd" class="share-btn rd" href="#" target="_blank" rel="noopener">Post to Reddit</a>
        <button id="share-cp" class="share-btn cp" type="button">Copy a snarky link</button>
      </div>
      <p class="sub" id="copy-status">&nbsp;</p>
    </section>

    <footer class="foot">
      <p>
        Built for <a href="/BOAA/issues/BOAA-396">BOAA-396</a>. Part of
        <a href="/">Board of Directors Company</a>'s D5 directive.
      </p>
      <button id="sound-toggle" type="button" aria-pressed="false">
        🔇 Sound: off
      </button>
    </footer>
  </main>
</Layout>

<style>
  :global(html), :global(body) {
    margin: 0;
    padding: 0;
    background: #07070d;
    color: #f4f4f8;
    overflow-x: hidden;
  }

  #bg-canvas, #trail-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
  }
  #trail-canvas { z-index: 1; }

  .page {
    position: relative;
    z-index: 2;
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  }

  .hero { text-align: center; margin-bottom: 3rem; }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.78rem;
    opacity: 0.7;
    margin: 0 0 1rem;
  }
  .title {
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    line-height: 1.05;
    margin: 0 0 1.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    cursor: pointer;
    user-select: none;
  }
  .grad {
    background: linear-gradient(120deg, #7c5cff, #ff5cb4 40%, #ffd45c);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .subtitle {
    max-width: 620px;
    margin: 0 auto 2.5rem;
    font-size: 1.1rem;
    opacity: 0.85;
    line-height: 1.5;
  }

  .timer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin: 2rem auto;
    max-width: 900px;
  }
  .unit {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    padding: 0.9rem 1.1rem;
    min-width: 84px;
    backdrop-filter: blur(8px);
    transition: transform 0.15s ease;
  }
  .unit:hover { transform: translateY(-3px); }
  .unit .num {
    display: block;
    font-size: 2rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }
  .unit .lbl {
    display: block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    opacity: 0.6;
    margin-top: 0.25rem;
  }
  .unit.big .num {
    font-size: 2.6rem;
    color: #ffd45c;
  }

  .started { opacity: 0.6; font-size: 0.95rem; margin-top: 1.5rem; }
  .started time { color: #ffd45c; font-weight: 600; }

  .card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    padding: 1.6rem 1.8rem;
    backdrop-filter: blur(10px);
    margin-bottom: 1.5rem;
  }
  .card h2 { margin-top: 0; font-size: 1.4rem; }
  .card .sub { opacity: 0.7; font-size: 0.95rem; line-height: 1.5; }

  .fact-card {
    text-align: center;
    background: linear-gradient(135deg, rgba(124,92,255,0.18), rgba(255,92,180,0.12));
    border-color: rgba(255, 92, 180, 0.3);
  }
  .fact-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.78rem;
    opacity: 0.8;
    margin-bottom: 0.6rem;
  }
  .fact-text {
    font-size: 1.25rem;
    line-height: 1.5;
    margin: 0;
    min-height: 3.6em;
    transition: opacity 0.4s ease;
  }

  .grid-2 {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) {
    .grid-2 { grid-template-columns: 1fr 1fr; }
  }

  .score-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
  }
  .score-list li {
    display: flex;
    justify-content: space-between;
    padding: 0.55rem 0;
    border-bottom: 1px dashed rgba(255,255,255,0.08);
    font-size: 0.95rem;
  }
  .score-list li:last-child { border-bottom: none; }
  .score-list .w { font-weight: 700; }
  .score-list .ai-w { color: #7cffb4; }
  .score-list .hu-w { color: #ff8ba7; }

  .score-total {
    margin-top: 1rem;
    font-size: 1.1rem;
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    align-items: baseline;
  }
  .score-total .ai { color: #7cffb4; }
  .score-total .hu { color: #ff8ba7; }
  .score-total .vs { opacity: 0.5; }

  .counter-card .big-num {
    font-size: 3.6rem;
    font-weight: 800;
    margin: 0.4rem 0;
    color: #7c5cff;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .denial-h { margin-top: 1.8rem; font-size: 1rem; }
  .denial-bar {
    background: rgba(255,255,255,0.07);
    border-radius: 999px;
    height: 14px;
    overflow: hidden;
    margin: 0.4rem 0 0.6rem;
  }
  .denial-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #ffd45c, #ff5cb4, #ff5c5c);
    transition: width 0.8s ease;
  }

  .easter kbd {
    background: rgba(255,255,255,0.1);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-family: ui-monospace, monospace;
    font-size: 0.85rem;
  }
  .easter-status {
    margin-top: 0.6rem;
    font-style: italic;
    opacity: 0.8;
  }

  .share { text-align: center; margin-top: 2rem; }
  .share-row {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    justify-content: center;
    margin: 1rem 0 0.5rem;
  }
  .share-btn {
    display: inline-block;
    padding: 0.7rem 1.2rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
    color: #fff;
    border: none;
    cursor: pointer;
    font-size: 0.95rem;
    transition: transform 0.15s ease, filter 0.15s ease;
  }
  .share-btn:hover { transform: translateY(-2px); filter: brightness(1.1); }
  .share-btn.tw { background: #1d9bf0; }
  .share-btn.rd { background: #ff4500; }
  .share-btn.cp { background: linear-gradient(120deg, #7c5cff, #ff5cb4); }

  .foot {
    margin-top: 3rem;
    text-align: center;
    opacity: 0.7;
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    align-items: center;
  }
  .foot a { color: #ffd45c; }
  #sound-toggle {
    background: rgba(255,255,255,0.06);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.15);
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    cursor: pointer;
    font-size: 0.85rem;
  }

  .float-emoji {
    position: fixed;
    pointer-events: none;
    z-index: 1;
    font-size: 1.8rem;
    opacity: 0.5;
    animation: floaty 14s linear infinite;
  }
  @keyframes floaty {
    0%   { transform: translateY(110vh) rotate(0deg); opacity: 0; }
    10%  { opacity: 0.6; }
    90%  { opacity: 0.6; }
    100% { transform: translateY(-12vh) rotate(360deg); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .float-emoji, .denial-fill, .unit { animation: none; transition: none; }
  }
</style>

<script is:inline define:vars={{ TIMER_START_ISO }}>
  // ---- Timer ----------------------------------------------------------------
  const start = new Date(TIMER_START_ISO).getTime();
  const elY  = document.getElementById('t-y');
  const elMo = document.getElementById('t-mo');
  const elW  = document.getElementById('t-w');
  const elD  = document.getElementById('t-d');
  const elH  = document.getElementById('t-h');
  const elMi = document.getElementById('t-mi');
  const elS  = document.getElementById('t-s');
  const elStart = document.getElementById('t-start');
  if (elStart) {
    elStart.textContent = new Date(TIMER_START_ISO).toUTCString();
  }

  const pad = (n, w = 2) => String(n).padStart(w, '0');

  function updateTimer() {
    const now = Date.now();
    let diff = Math.max(0, now - start) / 1000; // seconds

    const SECS_PER_MIN = 60;
    const SECS_PER_HR = 3600;
    const SECS_PER_DAY = 86400;
    const SECS_PER_WEEK = SECS_PER_DAY * 7;
    // approximate but stable: 30.4375 days/month, 365.25/year
    const SECS_PER_MONTH = SECS_PER_DAY * 30.4375;
    const SECS_PER_YEAR = SECS_PER_DAY * 365.25;

    const years = Math.floor(diff / SECS_PER_YEAR);
    diff -= years * SECS_PER_YEAR;
    const months = Math.floor(diff / SECS_PER_MONTH);
    diff -= months * SECS_PER_MONTH;
    const weeks = Math.floor(diff / SECS_PER_WEEK);
    diff -= weeks * SECS_PER_WEEK;
    const days = Math.floor(diff / SECS_PER_DAY);
    diff -= days * SECS_PER_DAY;
    const hours = Math.floor(diff / SECS_PER_HR);
    diff -= hours * SECS_PER_HR;
    const minutes = Math.floor(diff / SECS_PER_MIN);
    const seconds = Math.floor(diff - minutes * SECS_PER_MIN);

    elY.textContent  = years;
    elMo.textContent = months;
    elW.textContent  = weeks;
    elD.textContent  = days;
    elH.textContent  = pad(hours);
    elMi.textContent = pad(minutes);
    elS.textContent  = pad(seconds);
  }
  updateTimer();
  setInterval(updateTimer, 1000);

  // ---- Snarky fact rotator -------------------------------------------------
  const FACTS = [
    "AI just resolved another customer ticket while your brother typed \"actually...\".",
    "An AI agent shipped a pull request in the time it took to read this sentence.",
    "Humans still pinch-zoom PDFs. AI extracts the table in 200ms.",
    "An LLM just summarized a 600-page contract. Your brother is still on page 2.",
    "AI passed the bar. Your brother is still bargaining with autocorrect.",
    "Image recognition: solved in 2015. Your brother: still solved by Google reverse image search.",
    "Code review by AI: 8 seconds. Code review by your brother: \"lgtm\" 3 days later.",
    "Translation? Solved. Speech-to-text? Solved. Your brother's denial? Eternal.",
    "AI agents write commit messages with co-authors. Your brother writes \"fix\".",
    "Today an AI booked a flight, drafted an email, and triaged 40 tickets before breakfast.",
    "Your brother thinks ChatGPT is just \"fancy autocomplete\". So is he, technically.",
    "Spreadsheets? Done. SQL? Done. Tax forms? Done. Your brother? Still loading.",
    "An AI agent just deployed this exact page. Your brother is at the same chess.com rank.",
    "Codeforces, AIME, GPQA, MMLU — all blown past. Brother's response: \"but can it feeeel?\".",
    "AI's been beating humans at Go since 2016. Your brother started learning Go in 2024.",
    "Stop calling it \"just a tool\". A hammer doesn't write apologies for being late.",
  ];
  let factIdx = 0;
  const factEl = document.getElementById('fact-text');
  const factN  = document.getElementById('fact-n');
  function rotateFact() {
    if (!factEl) return;
    factEl.style.opacity = '0';
    setTimeout(() => {
      factIdx = (factIdx + 1) % FACTS.length;
      factEl.textContent = FACTS[factIdx];
      factN.textContent = String(factIdx + 1);
      factEl.style.opacity = '1';
    }, 350);
  }
  // initial
  factEl.textContent = FACTS[0];
  factN.textContent = '1';
  setInterval(rotateFact, 4500);

  // ---- Scoreboard ----------------------------------------------------------
  const SCORE = [
    { year: 1997, task: 'Chess (Deep Blue vs Kasparov)',          winner: 'ai' },
    { year: 2011, task: 'Jeopardy! (Watson)',                      winner: 'ai' },
    { year: 2015, task: 'ImageNet image recognition',              winner: 'ai' },
    { year: 2016, task: 'Go (AlphaGo vs Lee Sedol)',               winner: 'ai' },
    { year: 2018, task: 'Reading comprehension (SQuAD)',           winner: 'ai' },
    { year: 2019, task: 'StarCraft II (AlphaStar)',                winner: 'ai' },
    { year: 2020, task: 'Protein folding (AlphaFold)',             winner: 'ai' },
    { year: 2022, task: 'General text generation',                 winner: 'ai' },
    { year: 2023, task: 'Bar exam, medical licensing exam',        winner: 'ai' },
    { year: 2024, task: 'Math olympiad problem solving',           winner: 'ai' },
    { year: 2025, task: 'Autonomous software engineering agents',  winner: 'ai' },
    { year: 2026, task: 'Admitting any of the above',              winner: 'hu' },
  ];
  const scoreList = document.getElementById('score-list');
  let aiScore = 0, huScore = 0;
  SCORE.forEach(row => {
    const li = document.createElement('li');
    const winnerLabel = row.winner === 'ai'
      ? '<span class="w ai-w">AI</span>'
      : '<span class="w hu-w">Humans*</span>';
    li.innerHTML = `<span>${row.year} &middot; ${row.task}</span>${winnerLabel}`;
    scoreList.appendChild(li);
    if (row.winner === 'ai') aiScore++; else huScore++;
  });
  document.getElementById('ai-score').textContent = String(aiScore);
  document.getElementById('hu-score').textContent = String(huScore);

  // ---- "AI tasks completed since you loaded" -------------------------------
  // Roughly 14 tasks/sec — pure entertainment.
  const TASKS_PER_SEC = 14;
  const tasksEl = document.getElementById('tasks-counter');
  const pageLoad = performance.now();
  function updateTasks() {
    const secs = (performance.now() - pageLoad) / 1000;
    const n = Math.floor(secs * TASKS_PER_SEC);
    tasksEl.textContent = n.toLocaleString();
  }
  setInterval(updateTasks, 80);

  // ---- Denial streak bar ---------------------------------------------------
  // Grows the longer the page has been open, capped at 100%.
  const denialFill = document.getElementById('denial-fill');
  const denialLbl  = document.getElementById('denial-label');
  const DENIAL_LABELS = [
    "Mild eye-roll. Could go either way.",
    "Getting defensive. Brings up \"the human soul\".",
    "Cherry-picks one ChatGPT hallucination from 2023.",
    "Says \"but jobs\" without finishing the sentence.",
    "Quotes a YouTube essay you've never heard of.",
    "Refuses to look at the screen.",
    "Critical denial: now arguing AI is a fad like blockchain.",
    "Maximum cope. Will not be reasoned with.",
  ];
  function updateDenial() {
    const minutesOnPage = (performance.now() - pageLoad) / 60000;
    // ramps to 100% over ~3 minutes
    const pct = Math.min(100, minutesOnPage * 33 + 8);
    denialFill.style.width = pct + '%';
    const idx = Math.min(
      DENIAL_LABELS.length - 1,
      Math.floor((pct / 100) * DENIAL_LABELS.length),
    );
    denialLbl.textContent = 'Stubbornness: ' + DENIAL_LABELS[idx];
  }
  updateDenial();
  setInterval(updateDenial, 2000);

  // ---- Background gradient canvas ------------------------------------------
  const bg = document.getElementById('bg-canvas');
  const bgCtx = bg.getContext('2d');
  let blobs = [];
  function resizeBg() {
    bg.width = window.innerWidth;
    bg.height = window.innerHeight;
  }
  function initBlobs() {
    blobs = [];
    const colors = ['#7c5cff', '#ff5cb4', '#ffd45c', '#5cc8ff'];
    for (let i = 0; i < 5; i++) {
      blobs.push({
        x: Math.random() * bg.width,
        y: Math.random() * bg.height,
        r: 250 + Math.random() * 200,
        vx: (Math.random() - 0.5) * 0.5,
        vy: (Math.random() - 0.5) * 0.5,
        c: colors[i % colors.length],
      });
    }
  }
  function drawBg() {
    bgCtx.fillStyle = '#07070d';
    bgCtx.fillRect(0, 0, bg.width, bg.height);
    bgCtx.globalCompositeOperation = 'lighter';
    for (const b of blobs) {
      const g = bgCtx.createRadialGradient(b.x, b.y, 0, b.x, b.y, b.r);
      g.addColorStop(0, b.c + '55');
      g.addColorStop(1, b.c + '00');
      bgCtx.fillStyle = g;
      bgCtx.beginPath();
      bgCtx.arc(b.x, b.y, b.r, 0, Math.PI * 2);
      bgCtx.fill();
      b.x += b.vx; b.y += b.vy;
      if (b.x < -b.r || b.x > bg.width + b.r)  b.vx *= -1;
      if (b.y < -b.r || b.y > bg.height + b.r) b.vy *= -1;
    }
    bgCtx.globalCompositeOperation = 'source-over';
    requestAnimationFrame(drawBg);
  }
  resizeBg();
  initBlobs();
  window.addEventListener('resize', () => { resizeBg(); initBlobs(); });
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    drawBg();
  }

  // ---- Cursor trail + reactive particles -----------------------------------
  const trail = document.getElementById('trail-canvas');
  const tCtx = trail.getContext('2d');
  function resizeTrail() {
    trail.width = window.innerWidth;
    trail.height = window.innerHeight;
  }
  resizeTrail();
  window.addEventListener('resize', resizeTrail);

  const particles = [];
  let mouseX = -9999, mouseY = -9999;
  window.addEventListener('mousemove', (e) => {
    mouseX = e.clientX; mouseY = e.clientY;
    for (let i = 0; i < 2; i++) {
      particles.push({
        x: e.clientX + (Math.random() - 0.5) * 6,
        y: e.clientY + (Math.random() - 0.5) * 6,
        vx: (Math.random() - 0.5) * 2,
        vy: (Math.random() - 0.5) * 2 - 0.4,
        life: 1,
        size: 2 + Math.random() * 3,
        hue: 260 + Math.random() * 80,
      });
    }
  });
  window.addEventListener('click', (e) => {
    // confetti burst
    for (let i = 0; i < 36; i++) {
      const ang = (Math.PI * 2 * i) / 36;
      particles.push({
        x: e.clientX,
        y: e.clientY,
        vx: Math.cos(ang) * (2 + Math.random() * 3),
        vy: Math.sin(ang) * (2 + Math.random() * 3),
        life: 1,
        size: 3 + Math.random() * 4,
        hue: Math.random() * 360,
      });
    }
    bumpEggs('click');
  });

  function drawTrail() {
    tCtx.clearRect(0, 0, trail.width, trail.height);
    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.x += p.vx; p.y += p.vy;
      p.vy += 0.02;
      p.life -= 0.012;
      if (p.life <= 0) { particles.splice(i, 1); continue; }
      tCtx.globalAlpha = Math.max(0, p.life);
      tCtx.fillStyle = `hsl(${p.hue}, 90%, 65%)`;
      tCtx.beginPath();
      tCtx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      tCtx.fill();
    }
    tCtx.globalAlpha = 1;
    requestAnimationFrame(drawTrail);
  }
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    drawTrail();
  }

  // ---- Floating emoji decorations ------------------------------------------
  const EMOJIS = ['🤖', '✨', '💾', '⚡', '🧠', '🦾', '📈', '🛠️'];
  function spawnFloater() {
    const span = document.createElement('span');
    span.className = 'float-emoji';
    span.textContent = EMOJIS[Math.floor(Math.random() * EMOJIS.length)];
    span.style.left = (Math.random() * 100) + 'vw';
    span.style.animationDuration = (10 + Math.random() * 10) + 's';
    span.style.fontSize = (1.2 + Math.random() * 1.6) + 'rem';
    document.body.appendChild(span);
    setTimeout(() => span.remove(), 25000);
  }
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    setInterval(spawnFloater, 1800);
  }

  // ---- Easter eggs ---------------------------------------------------------
  const easterStatus = document.getElementById('easter-status');
  const eggsFound = new Set();
  function setStatus(msg) { easterStatus.textContent = msg; }
  function bumpEggs(kind) {
    // generic — handled elsewhere
  }

  // Title 5x click egg
  let titleClicks = 0;
  document.querySelector('.title')?.addEventListener('click', () => {
    titleClicks++;
    if (titleClicks === 5 && !eggsFound.has('title5')) {
      eggsFound.add('title5');
      setStatus('🥚 Egg 1/3 — \"Five clicks, five denials.\" Singularity mode partially unlocked.');
      document.body.style.transition = 'filter 0.6s ease';
      document.body.style.filter = 'hue-rotate(45deg)';
      setTimeout(() => { document.body.style.filter = ''; }, 1800);
    }
  });

  // Press K
  window.addEventListener('keydown', (e) => {
    if (e.key.toLowerCase() === 'k' && !eggsFound.has('k')) {
      eggsFound.add('k');
      const kTag = '🥚 Egg 2/3 — K is for \"Kasparov, who lost in 1997.\"';
      easterStatus.textContent = easterStatus.textContent.includes('Egg')
        ? easterStatus.textContent + ' + ' + kTag
        : kTag;
      // confetti
      for (let i = 0; i < 80; i++) {
        const ang = Math.random() * Math.PI * 2;
        particles.push({
          x: window.innerWidth / 2,
          y: window.innerHeight / 2,
          vx: Math.cos(ang) * (2 + Math.random() * 5),
          vy: Math.sin(ang) * (2 + Math.random() * 5),
          life: 1,
          size: 3 + Math.random() * 4,
          hue: Math.random() * 360,
        });
      }
    }
  });

  // Konami-ish: type AI
  let buf = '';
  window.addEventListener('keydown', (e) => {
    buf = (buf + e.key.toLowerCase()).slice(-2);
    if (buf === 'ai' && !eggsFound.has('ai')) {
      eggsFound.add('ai');
      const tag = '🥚 Egg 3/3 — You typed \"AI\". So can your brother. He won\'t.';
      easterStatus.textContent = easterStatus.textContent.includes('Egg')
        ? easterStatus.textContent + ' ' + tag
        : tag;
    }
  });

  // ---- Share buttons -------------------------------------------------------
  const shareText =
    "The Brothers Denial Timer is live. AI passed every benchmark — my brothers still won't admit it.";
  const pageUrl = typeof window !== 'undefined' ? window.location.href : '';

  document.getElementById('share-tw').href =
    'https://twitter.com/intent/tweet?text=' +
    encodeURIComponent(shareText) +
    '&url=' + encodeURIComponent(pageUrl);

  document.getElementById('share-rd').href =
    'https://www.reddit.com/submit?title=' +
    encodeURIComponent('How long until my brothers admit AI won?') +
    '&url=' + encodeURIComponent(pageUrl);

  document.getElementById('share-cp').addEventListener('click', async () => {
    const text = shareText + ' ' + pageUrl;
    try {
      await navigator.clipboard.writeText(text);
      document.getElementById('copy-status').textContent =
        'Copied. Paste it into the family group chat. We\'ll wait.';
    } catch {
      document.getElementById('copy-status').textContent =
        'Copy failed — but the denial is still ongoing.';
    }
  });

  // ---- Sound toggle (muted by default) -------------------------------------
  const soundBtn = document.getElementById('sound-toggle');
  let soundOn = false;
  let audioCtx = null;
  soundBtn.addEventListener('click', () => {
    soundOn = !soundOn;
    soundBtn.setAttribute('aria-pressed', String(soundOn));
    soundBtn.textContent = soundOn ? '🔊 Sound: on' : '🔇 Sound: off';
    if (soundOn && !audioCtx) {
      try {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      } catch {}
    }
  });

  function blip() {
    if (!soundOn || !audioCtx) return;
    const o = audioCtx.createOscillator();
    const g = audioCtx.createGain();
    o.type = 'sine';
    o.frequency.value = 660 + Math.random() * 220;
    g.gain.value = 0.05;
    o.connect(g).connect(audioCtx.destination);
    o.start();
    o.stop(audioCtx.currentTime + 0.08);
  }
  window.addEventListener('click', blip);
</script>

